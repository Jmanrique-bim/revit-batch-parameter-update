<UserControl x:Class="BatchParamUpdate.UI.Wpf.Views.TypeParameterDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8"
               Text="Dialog Box 2 — Type parameters" />
    <TextBlock DockPanel.Dock="Bottom"
               Margin="0,8,0,0"
               TextWrapping="Wrap"
               Foreground="#B36B00"
               Text="Updating a Type parameter changes every element in the model that shares that type, not only the current selection."
               Visibility="{Binding ShowWideBlastWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
    <TextBlock DockPanel.Dock="Bottom"
               Margin="0,8,0,0"
               Text="No parameters match your search."
               Visibility="{Binding HasNoTypeResults, Converter={StaticResource BooleanToVisibilityConverter}}" />
    <ListBox ItemsSource="{Binding FilteredTypeCandidates}"
             DisplayMemberPath="Name"
             SelectedItem="{Binding SelectedType}" />
  </DockPanel>
</UserControl>
