<UserControl x:Class="BatchParamUpdate.UI.Wpf.Views.TypeParameterDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/BatchParamUpdate.UI.Wpf;component/Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Background="White">
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,7">
        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Type parameters" />
      </Border>
      <TextBlock DockPanel.Dock="Bottom"
                 Background="{StaticResource WarnBackgroundBrush}"
                 Foreground="{StaticResource WarnTextBrush}"
                 BorderBrush="{StaticResource WarnBorderBrush}"
                 BorderThickness="0,1,0,0"
                 Padding="10,7"
                 FontSize="11.5"
                 TextWrapping="Wrap"
                 Text="Updating a Type parameter changes every element in the model that shares that type, not only the current selection."
                 Visibility="{Binding ShowWideBlastWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <TextBlock DockPanel.Dock="Bottom"
                 Margin="10,8"
                 Foreground="{StaticResource MutedTextBrush}"
                 Text="No parameters match your search."
                 Visibility="{Binding HasNoTypeResults, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <ListBox ItemsSource="{Binding FilteredTypeCandidates}"
               SelectedItem="{Binding SelectedType}"
               Style="{StaticResource ParameterListBoxStyle}"
               ItemContainerStyle="{StaticResource ParameterListBoxItemStyle}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1"
                         Text="{Binding SourceElementRefs.Count}"
                         FontFamily="Consolas"
                         FontSize="10.5"
                         Foreground="{StaticResource IndigoBrush}"
                         VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>
</UserControl>
