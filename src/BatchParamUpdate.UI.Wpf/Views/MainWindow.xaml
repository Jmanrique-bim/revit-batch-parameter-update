<Window x:Class="BatchParamUpdate.UI.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BatchParamUpdate.UI.Wpf.Views"
        Title="Batch Parameter Update"
        Height="720"
        Width="840">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Button x:Name="SelectElementsButton"
            Grid.Row="0"
            Content="Select Elements"
            Command="{Binding SelectElementsCommand}"
            IsEnabled="{Binding IsSelectElementsEnabled}"
            HorizontalAlignment="Left"
            Padding="12,6"
            MinWidth="140" />
    <TextBlock x:Name="EmptyScopeBanner"
               Grid.Row="1"
               Margin="0,12,0,0"
               Text="No elements are in scope. Select one or more elements before continuing."
               TextWrapping="Wrap"
               Foreground="#B00020"
               Visibility="{Binding HasNoElementsInScope, Converter={StaticResource BooleanToVisibilityConverter}}" />
    <TextBox x:Name="SharedSearchBox"
             Grid.Row="2"
             Margin="0,12,0,0"
             MinHeight="28"
             VerticalContentAlignment="Center"
             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <views:InstanceParameterDialog x:Name="InstanceDialog" Grid.Column="0" />
      <views:TypeParameterDialog x:Name="TypeDialog" Grid.Column="2" />
    </Grid>
    <TextBlock x:Name="AdvanceErrorBanner"
               Grid.Row="4"
               Margin="0,12,0,0"
               Foreground="#B00020"
               TextWrapping="Wrap"
               Text="{Binding AdvanceErrorMessage}" />
    <StackPanel x:Name="ReplacementPanel" Grid.Row="5" Margin="0,12,0,0">
      <TextBlock x:Name="CurrentValueBanner"
                 Margin="0,0,0,8"
                 TextWrapping="Wrap"
                 Text="{Binding CurrentValueSummary}"
                 Visibility="{Binding HasCurrentValueSummary, Converter={StaticResource BooleanToVisibilityConverter}}" />
      <TextBlock Text="Replacement value" Margin="0,0,0,4" />
      <TextBox MinHeight="28"
               VerticalContentAlignment="Center"
               Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Margin="0,4,0,0"
                 Foreground="#B00020"
                 TextWrapping="Wrap"
                 Text="{Binding ValidationMessage}" />
      <Button Margin="0,8,0,0"
              Content="Run update"
              Command="{Binding RunCommand}"
              HorizontalAlignment="Left"
              Padding="12,6"
              MinWidth="140" />
    </StackPanel>
    <ProgressBar x:Name="ExecutionProgress"
                 Grid.Row="6"
                 Margin="0,12,0,0"
                 Height="16"
                 IsIndeterminate="True"
                 Visibility="{Binding IsExecuting, Converter={StaticResource BooleanToVisibilityConverter}}" />
    <StackPanel x:Name="SummaryPanel" Grid.Row="7" Margin="0,12,0,0">
      <TextBlock FontWeight="SemiBold" Text="{Binding Headline}" TextWrapping="Wrap" />
      <ItemsControl Margin="0,8,0,0"
                    ItemsSource="{Binding Skips}"
                    Visibility="{Binding HasSkips, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap">
              <Run Text="{Binding Element.DisplayLabel, Mode=OneWay}" />
              <Run Text=" — " />
              <Run Text="{Binding Message, Mode=OneWay}" />
            </TextBlock>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Grid>
</Window>
