<UserControl x:Class="BatchParamUpdate.UI.Wpf.Views.InstanceParameterDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8"
               Text="Instance parameters" />
    <TextBlock DockPanel.Dock="Bottom"
               Margin="0,8,0,0"
               Text="No parameters match your search."
               Visibility="{Binding HasNoInstanceResults, Converter={StaticResource BooleanToVisibilityConverter}}" />
    <ListBox ItemsSource="{Binding FilteredInstanceCandidates}"
             DisplayMemberPath="Name"
             SelectedItem="{Binding SelectedInstance}" />
  </DockPanel>
</UserControl>
