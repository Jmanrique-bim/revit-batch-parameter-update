<Window x:Class="BatchParamUpdate.Installer.Views.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Parameter Update — Installer"
        Height="360"
        Width="520"
        MinHeight="280"
        MinWidth="420">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top"
               FontSize="18"
               FontWeight="SemiBold"
               Text="Manage add-in per installed Revit year" />
    <TextBlock DockPanel.Dock="Top"
               Margin="0,8,0,12"
               TextWrapping="Wrap"
               Foreground="#555"
               Text="Supported years are Revit 2025, 2026, and 2027 only. Actions are offered solely for versions detected on this machine." />
    <TextBlock DockPanel.Dock="Bottom"
               Margin="0,12,0,0"
               TextWrapping="Wrap"
               Text="{Binding Status}" />
    <ListBox ItemsSource="{Binding Years}" BorderThickness="0">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel Margin="0,0,0,12" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       MinWidth="90"
                       Text="{Binding Year, StringFormat=Revit {0}}" />
            <Button DockPanel.Dock="Left"
                    Margin="8,0,0,0"
                    Padding="12,6"
                    Content="Install"
                    Command="{Binding InstallCommand}" />
            <Button DockPanel.Dock="Left"
                    Margin="8,0,0,0"
                    Padding="12,6"
                    Content="Update"
                    Command="{Binding UpdateCommand}" />
            <Button DockPanel.Dock="Left"
                    Margin="8,0,0,0"
                    Padding="12,6"
                    Content="Uninstall"
                    Command="{Binding UninstallCommand}" />
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
